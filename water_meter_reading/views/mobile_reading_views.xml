<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_water_reading_mobile_selector_form" model="ir.ui.view">
    <field name="name">water.reading.mobile.selector.form</field>
    <field name="model">water.reading.mobile.selector</field>
    <field name="arch" type="xml">
      <form string="Seleccionar contador" class="o_water_mobile_selector">
        <header>
          <button name="action_open_reading" type="object" string="Abrir lectura"
                  icon="fa-arrow-right" class="btn-primary"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>Seleccionar contador</h1>
          </div>
          <group>
            <field name="period_id"/>
            <field name="only_pending"/>
                     <field name="street_id" string="Calle"
                   options="{'no_create': true, 'no_open': true}"
                       placeholder="Buscar calle"/>
            <field name="meter_id"
                   options="{'no_create': true, 'no_open': true}"
                   placeholder="Número, abonado, nombre o calle"/>
            <field name="total_count" string="Total contadores" readonly="1"/>
            <field name="read_count" string="Contadores leídos" readonly="1"/>
            <field name="available_count" string="Pendientes" readonly="1"/>
            <field name="available_meter_ids" invisible="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_water_reading_mobile_form" model="ir.ui.view">
    <field name="name">water.reading.mobile.form</field>
    <field name="model">water.reading</field>
    <field name="arch" type="xml">
      <form string="Lectura móvil" class="o_water_mobile_reading">
        <header>
          <button name="action_mobile_done" type="object" string="Guardar"
            icon="fa-check" class="btn-primary btn-sm o_water_mobile_action"/>
          <button name="action_mobile_next" type="object" string="Siguiente"
            icon="fa-arrow-right" class="btn-secondary btn-sm o_water_mobile_action"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="Pendiente" bg_color="text-bg-danger"
                  invisible="reading_current != 0"/>
          <field name="allow_edit_previous" invisible="1"/>
          <div class="o_water_mobile_heading">
            <div class="oe_title">
              <h1><field name="meter_number" readonly="1" nolabel="1"/></h1>
            </div>
            <field name="mobile_progress" readonly="1" nolabel="1"
                   class="o_water_mobile_progress"/>
          </div>

          <group string="Ubicación" class="o_water_mobile_location">
            <group class="o_water_mobile_location_column">
              <field name="meter_id" readonly="1"/>
              <field name="meter_owner_name" readonly="1"/>
              <field name="meter_subscriber" readonly="1"/>
            </group>
            <group class="o_water_mobile_location_column">
              <field name="meter_route" readonly="1"/>
              <field name="meter_street" string="Calle" readonly="1"/>
              <field name="meter_street_number" string="Nº" readonly="1"/>
              <field name="meter_municipality" readonly="1"/>
            </group>
          </group>

          <div class="o_water_mobile_capture">
            <div class="o_water_mobile_values">
              <label for="reading_previous"/>
              <field name="reading_previous" readonly="not allow_edit_previous"/>
              <label for="reading_current"/>
              <field name="reading_current" class="o_water_mobile_current"/>
              <label for="difference"/>
              <field name="difference" readonly="1"/>
            </div>
            <field name="counter_photo" widget="camera_image" nolabel="1"
                   class="o_water_mobile_photo" options="{'size': [240, 240]}"/>
          </div>

          <group string="Últimas lecturas">
            <field name="history_reading_ids" readonly="1" nolabel="1">
              <list string="Últimas lecturas">
                <field name="period_id" string="Período"/>
                <field name="reading_previous" string="Lectura anterior"/>
                <field name="reading_current" string="Lectura actual"/>
                <field name="difference" string="Consumo"/>
              </list>
            </field>
          </group>

          <group string="Incidencias del contador">
            <group>
              <field name="new_meter"/>
              <field name="previous_meter_number" invisible="not new_meter"/>
              <field name="new_meter_number" invisible="not new_meter" required="new_meter"/>
            </group>
            <group>
              <field name="meter_reversed" string="Contador dio la vuelta"/>
              <field name="meter_max_value"
                     invisible="not meter_reversed" required="meter_reversed"/>
            </group>
          </group>

          <group string="Observaciones">
            <field name="observations" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>