<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Añade el checkbox en el formulario de usuario (Ajustes > Usuarios) -->
  <record id="view_users_form_water_reading" model="ir.ui.view">
    <field name="name">res.users.form.water.reading</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Lecturas Agua" name="water_readings">
          <group>
            <field name="can_edit_readings"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
