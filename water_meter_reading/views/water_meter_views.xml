<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Menú principal -->
  <record id="menu_water_root" model="ir.ui.menu">
    <field name="name">Lecturas Agua</field>
    <field name="sequence">10</field>
  </record>

  <!-- Acción: Contadores -->
  <record id="action_water_meter" model="ir.actions.act_window">
    <field name="name">Contadores</field>
    <field name="res_model">water.meter</field>
    <field name="view_mode">list,form</field>
    <field name="context">{"search_default_active": 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea tu primer contador</p>
    </field>
  </record>

  <menuitem id="menu_water_meters" name="Contadores" parent="menu_water_root"
            action="action_water_meter" sequence="2"/>

  <!-- Vista lista: Contadores -->
  <record id="view_water_meter_list" model="ir.ui.view">
    <field name="name">water.meter.list</field>
    <field name="model">water.meter</field>
    <field name="arch" type="xml">
      <list string="Contadores">
        <field name="name"/>
        <field name="meter_number"/>
        <field name="owner_name"/>
        <field name="subscriber" optional="hide"/>
        <field name="meter_type" optional="show"/>
        <field name="new_meter" optional="hide"/>
        <field name="address"/>
        <field name="municipality"/>
        <field name="reversed_meter" optional="hide"/>
      </list>
    </field>
  </record>

  <!-- Vista búsqueda: Contadores -->
  <record id="view_water_meter_search" model="ir.ui.view">
    <field name="name">water.meter.search</field>
    <field name="model">water.meter</field>
    <field name="arch" type="xml">
      <search string="Buscar contadores">
        <field name="name" string="Ruta"/>
        <field name="meter_number" string="Contador"/>
        <field name="owner_name" string="Nombre"/>
        <field name="municipality" string="Municipio"/>
        <separator/>
        <filter string="Activos" name="active" domain="[('active','=',True)]"/>
        <filter string="Archivados" name="archived" domain="[('active','=',False)]"/>
        <filter string="Todos" name="all" domain="[('active','in',[True,False])]"/>
      </search>
    </field>
  </record>
  <record id="view_water_meter_form" model="ir.ui.view">
    <field name="name">water.meter.form</field>
    <field name="model">water.meter</field>
    <field name="arch" type="xml">
      <form string="Contador">
        <sheet>
          <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                  invisible="active"/>
          <group string="Datos del contador">
            <group>
              <field name="name"/>
              <field name="meter_number"/>
              <field name="owner_name"/>
              <field name="subscriber"/>
              <field name="cadastral_ref"/>
              <field name="meter_type"/>
              <field name="new_meter"/>
              <field name="reversed_meter"/>
              <field name="meter_max_value"
                     invisible="not reversed_meter"
                     required="reversed_meter"/>
            </group>
            <group>
              <field name="address"/>
              <field name="zip"/>
              <field name="municipality"/>
            </group>
          </group>
          <notebook>
            <page string="Historial de lecturas">
              <field name="reading_ids">
                <list editable="bottom" string="Lecturas">
                  <field name="name"/>
                  <field name="date"/>
                  <field name="allow_edit_previous" column_invisible="1"/>
                  <field name="reading_previous" readonly="not allow_edit_previous"/>
                  <field name="reading_current"/>
                  <field name="difference" readonly="1"/>
                  <field name="observations"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción: Lecturas -->
  <record id="action_water_reading" model="ir.actions.act_window">
    <field name="name">Lecturas</field>
    <field name="res_model">water.reading</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Registra la primera lectura</p>
    </field>
  </record>

  <!-- Menú Lecturas eliminado: acceso solo a través de Períodos -->

  <!-- Vista búsqueda: Lecturas -->
  <record id="view_water_reading_search" model="ir.ui.view">
    <field name="name">water.reading.search</field>
    <field name="model">water.reading</field>
    <field name="arch" type="xml">
      <search string="Buscar lecturas">
        <field name="meter_number" string="Contador"/>
        <field name="meter_route" string="Ruta"/>
        <field name="meter_owner_name" string="Nombre"/>
        <field name="meter_municipality" string="Municipio"/>
        <field name="meter_zip" string="Código postal"/>
        <filter string="Diferencia negativa" name="negative_diff"
                domain="[('difference','&lt;',0)]"/>
        <group>
          <filter string="Período" name="group_period"
                  context="{'group_by': 'period_id'}"/>
          <filter string="Municipio" name="group_municipality"
                  context="{'group_by': 'meter_municipality'}"/>
          <filter string="Ruta" name="group_route"
                  context="{'group_by': 'meter_route'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Vista lista: Lecturas -->
  <record id="view_water_reading_list" model="ir.ui.view">
    <field name="name">water.reading.list</field>
    <field name="model">water.reading</field>
    <field name="arch" type="xml">
      <list string="Lecturas" decoration-danger="difference &lt; 0">
        <field name="name"/>
        <field name="period_id" string="Período"/>
        <field name="meter_number" string="Contador"/>
        <field name="meter_route" string="Ruta"/>
        <field name="date"/>
        <field name="reading_previous"/>
        <field name="reading_current"/>
        <field name="difference"/>
        <field name="user_id"/>
      </list>
    </field>
  </record>

  <!-- Vista formulario: Lecturas -->
  <record id="view_water_reading_form" model="ir.ui.view">
    <field name="name">water.reading.form</field>
    <field name="model">water.reading</field>
    <field name="arch" type="xml">
      <form string="Lectura">
        <sheet>
          <field name="counter_photo" widget="image" class="oe_avatar"
                 options="{'size': [128, 128], 'zoom': true}"/>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group string="Datos de la lectura">
            <group>
              <field name="meter_id" string="Seleccionar contador"/>
              <field name="meter_number" string="Contador" readonly="1"/>
              <field name="meter_route" string="Ruta"/>
              <field name="period_id" string="Período"/>
              <field name="date"/>
              <field name="user_id"/>
            </group>
            <group>
              <field name="reading_previous" readonly="not allow_edit_previous"/>
              <field name="reading_current"/>
              <field name="difference" readonly="1"/>
            </group>
          </group>
          <field name="allow_edit_previous" invisible="1"/>
          <group string="Observaciones">
            <field name="observations" nolabel="1" placeholder="Notas sobre esta lectura..."/>
          </group>
          <notebook>
            <page string="Fotografías adicionales" name="photos">
              <field name="photo_ids">
                <list editable="bottom" string="Fotos">
                  <field name="image_name"/>
                  <field name="image" widget="image" options="{'size': [64, 64]}"/>
                  <field name="timestamp"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

</odoo>
