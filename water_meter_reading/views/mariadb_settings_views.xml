<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_water_meter_mariadb_settings" model="ir.ui.view">
    <field name="name">water.meter.mariadb.settings.form</field>
    <field name="model">res.config.settings</field>
    <field name="arch" type="xml">
      <form string="Conexión MariaDB">
        <header>
          <button name="action_test_mariadb_connection" type="object"
                  string="Probar conexión" class="btn-primary"/>
        </header>
        <sheet>
          <group string="Base de datos de origen">
            <group>
              <field name="mariadb_host"/>
              <field name="mariadb_port"/>
              <field name="mariadb_database"/>
            </group>
            <group>
              <field name="mariadb_user"/>
              <field name="mariadb_password" password="True"/>
            </group>
          </group>
          <footer>
            <button name="action_test_mariadb_connection" type="object"
                    string="Probar conexión" class="btn-primary"/>
            <button string="Guardar" type="object" name="execute" class="btn-secondary"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_water_meter_mariadb_settings" model="ir.actions.act_window">
    <field name="name">Conexión MariaDB</field>
    <field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_water_meter_mariadb_settings"/>
    <field name="target">current</field>
  </record>

  <record id="menu_water_mariadb_settings" model="ir.ui.menu">
    <field name="name">Conexión MariaDB</field>
    <field name="parent_id" ref="menu_water_root"/>
    <field name="action" ref="action_water_meter_mariadb_settings"/>
    <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    <field name="sequence">10</field>
    <field name="active" eval="False"/>
  </record>
</odoo>