<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_water_period_gap_estimation_form" model="ir.ui.view">
    <field name="name">water.period.gap.estimation.form</field>
    <field name="model">water.period.gap.estimation</field>
    <field name="arch" type="xml">
      <form string="Estimar período sin lecturas">
        <header>
          <button name="action_confirm" type="object"
                  string="Confirmar estimación" class="btn-primary"
                  icon="fa-check"/>
        </header>
        <sheet>
          <div class="alert alert-warning" role="alert">
            Esta operación creará lecturas estimadas en el período anterior. Revisa la vista previa antes de confirmar.
          </div>
          <group>
            <field name="source_period_id"/>
            <field name="target_period_id"/>
            <field name="variation"/>
            <field name="confirmed"/>
            <field name="summary" nolabel="1"/>
          </group>
          <field name="line_ids" nolabel="1">
            <list string="Vista previa de estimación">
              <field name="status"/>
              <field name="meter_number"/>
              <field name="subscriber"/>
              <field name="before_reading"/>
              <field name="source_reading"/>
              <field name="estimated_reading"/>
              <field name="share"/>
              <field name="message"/>
            </list>
          </field>
          <footer>
            <button name="action_confirm" type="object"
                    string="Confirmar estimación" class="btn-primary"/>
            <button string="Cancelar" special="cancel" class="btn-secondary"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
