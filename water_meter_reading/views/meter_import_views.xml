<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_water_meter_import_form" model="ir.ui.view">
    <field name="name">water.meter.import.form</field>
    <field name="model">water.meter.import</field>
    <field name="arch" type="xml">
      <form string="Importar contadores">
        <group>
          <field name="file" filename="filename" string="Archivo CSV o XLSX"/>
          <field name="filename" invisible="1"/>
        </group>
        <footer>
          <button name="action_import" string="Importar" type="object" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_water_meter_import" model="ir.actions.act_window">
    <field name="name">Importar contadores</field>
    <field name="res_model">water.meter.import</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="model_water_meter"/>
    <field name="binding_view_types">list</field>
  </record>

  <record id="action_open_water_meter_import" model="ir.actions.server">
    <field name="name">Importar contadores</field>
    <field name="model_id" ref="model_water_meter"/>
    <field name="state">code</field>
    <field name="code">action = env['water.meter'].action_open_import()</field>
  </record>

  <menuitem id="menu_water_meter_import" name="Importar contadores"
            parent="menu_water_root" action="action_open_water_meter_import" sequence="3"/>
</odoo>