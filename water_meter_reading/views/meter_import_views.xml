<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_water_meter_import_form" model="ir.ui.view">
    <field name="name">water.meter.import.form</field>
    <field name="model">water.meter.import</field>
    <field name="arch" type="xml">
      <form string="Importar contadores">
        <group>
          <field name="period_id" readonly="1"/>
          <field name="file" filename="filename" string="Archivo CSV o XLSX"/>
          <field name="filename" invisible="1"/>
        </group>
        <footer>
          <button name="action_import" string="Importar" type="object" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

</odoo>