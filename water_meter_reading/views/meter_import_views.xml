<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_water_meter_import_form" model="ir.ui.view">
    <field name="name">water.meter.import.form</field>
    <field name="model">water.meter.import</field>
    <field name="arch" type="xml">
      <form string="Importar censo">
        <group>
          <field name="period_id" readonly="1"/>
          <field name="import_readings" invisible="1"/>
          <field name="file" filename="filename"
                 string="Archivo CSV o XLSX"/>
          <field name="filename" invisible="1"/>
          <field name="confirmation_required" invisible="1"/>
        </group>
        <group string="Se han encontrado lecturas diferentes"
               invisible="not confirmation_required">
          <field name="warning_message" nolabel="1" readonly="1"/>
        </group>
        <footer>
          <button name="action_import" string="Importar" type="object" class="btn-primary"
                  invisible="confirmation_required"/>
          <button name="action_import_confirmed" string="Importar igualmente" type="object"
                  class="btn-danger" invisible="not confirmation_required"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

</odoo>