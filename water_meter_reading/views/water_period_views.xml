<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Acción: Períodos -->
  <record id="action_water_period" model="ir.actions.act_window">
    <field name="name">Períodos</field>
    <field name="res_model">water.period</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea el primer período trimestral</p>
    </field>
  </record>

  <menuitem id="menu_water_periods" name="Períodos" parent="menu_water_root"
            action="action_water_period" sequence="1"/>

  <!-- Acción servidor: ir a Contadores desde el menú ⚙️ -->
  <record id="action_goto_contadores" model="ir.actions.server">
    <field name="name">Contadores</field>
    <field name="model_id" ref="water_meter_reading.model_water_period"/>
    <field name="binding_model_id" ref="water_meter_reading.model_water_period"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Contadores',
    'res_model': 'water.meter',
    'view_mode': 'list,form',
}
    </field>
  </record>

  <!-- Vista lista: Períodos -->
  <record id="view_water_period_list" model="ir.ui.view">
    <field name="name">water.period.list</field>
    <field name="model">water.period</field>
    <field name="arch" type="xml">
      <list string="Períodos">
        <field name="name" string="Período"/>
        <field name="trimester"/>
        <field name="year"/>
        <field name="state"/>
        <field name="reading_count" string="Nº lecturas"/>
      </list>
    </field>
  </record>

  <!-- Vista formulario: Períodos -->
  <record id="view_water_period_form" model="ir.ui.view">
    <field name="name">water.period.form</field>
    <field name="model">water.period</field>
    <field name="arch" type="xml">
      <form string="Período">
        <header>
          <button name="action_start_mobile_readings" type="object"
                  string="Modo lectura móvil" class="btn-primary"
                  icon="fa-mobile" invisible="not reading_ids"/>
          <button name="action_open_meter_import" type="object"
              string="Importar censo" class="btn-secondary"
              icon="fa-upload" invisible="state == 'closed'"/>
            <button name="action_open_read_meter_import" type="object"
              string="Importar censo ya leído" class="btn-secondary"
              icon="fa-upload" groups="water_meter_reading.group_water_supervisor"
              invisible="state == 'closed'"/>
          <button name="action_export_excel" type="object"
                  string="Exportar Excel" class="btn btn-secondary"
                  icon="fa-download"/>
          <button name="action_close" type="object"
                  string="Cerrar período"
                  invisible="state != 'open'"/>
          <button name="action_reopen" type="object"
                  string="Reabrir período"
                  invisible="state != 'closed'"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,open,closed"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="action"
                    name="%(water_meter_reading.action_water_meter)d"
                    icon="fa-tachometer">
              <div class="o_stat_info">
                <span class="o_stat_text">Contadores</span>
              </div>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="trimester"/>
              <field name="year"/>
              <field name="show_unread"/>
            </group>
            <group>
              <field name="reading_count" string="Contadores registrados"/>
              <field name="pending_count" string="Contadores pendientes"/>
              <field name="read_count" string="Contadores leídos"/>
            </group>
          </group>
          <notebook>
            <page string="Lecturas" name="readings">
              <field name="reading_ids" invisible="show_unread">
                <list string="Lecturas" editable="bottom"
                    decoration-danger="reading_current == 0 or difference &lt; 0">
                  <field name="allow_edit_previous" column_invisible="1"/>
                            <field name="meter_id" string="Contador" readonly="1"
                              optional="show"
                              options="{'no_open': false, 'open_form_view': true}"/>
                  <field name="meter_route_link" string="Ruta" readonly="1" optional="show"/>
                  <field name="meter_owner_link" string="Nombre" readonly="1" optional="show"/>
                      <field name="meter_municipality" string="Municipio" readonly="1" optional="hide"/>
                  <field name="meter_zip" string="C.P." readonly="1" optional="hide"/>
                      <field name="date" optional="hide"/>
                      <field name="reading_previous" string="Lectura anterior"
                        readonly="not allow_edit_previous" optional="show"/>
                      <field name="reading_current" string="Lectura actual" optional="show"/>
                      <field name="difference" string="Consumo" readonly="1" optional="show"/>
                      <field name="new_meter" string="Contador nuevo" optional="hide"/>
                      <field name="previous_meter_number" string="Contador anterior"
                        readonly="1" optional="hide"/>
                      <field name="new_meter_number" string="Nuevo contador"
                        invisible="not new_meter" required="new_meter" optional="hide"/>
                      <field name="meter_reversed" string="Contador al revés" optional="hide"/>
                      <field name="meter_max_value" string="Valor máximo"
                        invisible="not meter_reversed" required="meter_reversed" optional="hide"/>
                          <field name="meter_closed" string="Cerrado" optional="hide"/>
                          <field name="meter_missing" string="Sin contador" optional="hide"/>
                          <field name="meter_broken" string="Roto" optional="hide"/>
                      <field name="observations" optional="show"/>
                      <field name="counter_photo" widget="camera_image" string="Foto"
                            options="{&quot;size&quot;: [64, 64], &quot;zoom&quot;: true}"
                            optional="show"/>
                </list>
              </field>
              <field name="unread_reading_ids" invisible="not show_unread">
                <list string="Lecturas sin leer" decoration-danger="True">
                  <field name="meter_id" string="Contador" readonly="1"
                         options="{'no_open': false, 'open_form_view': true}"/>
                  <field name="meter_route_link" string="Ruta" readonly="1"/>
                  <field name="meter_owner_link" string="Nombre" readonly="1"/>
                  <field name="reading_previous" string="Lectura anterior" readonly="1"/>
                  <field name="reading_current" string="Lectura actual" readonly="1"/>
                  <field name="difference" string="Consumo" readonly="1"/>
                  <field name="observations" readonly="1"/>
                  <field name="counter_photo" widget="image" string="Foto" readonly="1"
                         options="{'size': [64, 64], 'zoom': true}"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

</odoo>
