<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_water_meter_reading" model="ir.module.category">
    <field name="name">Lecturas Agua</field>
    <field name="sequence">20</field>
  </record>

  <record id="group_water_user" model="res.groups">
    <field name="name">Usuario</field>
    <field name="category_id" ref="module_water_meter_reading"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_water_supervisor" model="res.groups">
    <field name="name">Supervisor</field>
    <field name="category_id" ref="module_water_meter_reading"/>
    <field name="implied_ids" eval="[(4, ref('group_water_user'))]"/>
    <field name="users" eval="[(4, ref('base.user_admin'))]"/>
  </record>
</odoo>
